# LY 挂机控制台环境变量示例
# 使用方法：复制本文件为 .env，然后修改下面的值。

# 控制台监听端口。默认 30123。
DASHBOARD_PORT=30123

# 控制台监听地址。
# 推荐保持 127.0.0.1，然后用 Nginx/Caddy 通过域名反向代理访问。
# 如果你一定要直接用 http://服务器IP:30123 访问，改成 0.0.0.0，并确保已设置强密码。
DASHBOARD_HOST=127.0.0.1

# 控制台访问用户名。默认 admin。
DASHBOARD_USER=admin

# 控制台访问密码。
# 部署到公网服务器时必须改成强密码；留空表示不启用访问保护，只适合本机调试。
DASHBOARD_PASSWORD=请改成你的强密码

# 可选：指定真实配置文件位置。
# 不填时默认使用项目目录里的 bot.config.json。
# BOT_CONFIG_PATH=/opt/pcl-afk-bot/bot.config.json

# 注意：
# 1. 你买的域名不是填在这里，域名要在 DNS 服务商后台解析到轻量云服务器公网 IP。
# 2. Minecraft 服务器地址请在网页控制台的“服务器配置”里填写。
# 3. 推荐用 Nginx 或 Caddy 把 https://bot.你的域名.com 反向代理到 http://127.0.0.1:30123。
